[settings]
arch=x86_64
build_type=Release
compiler=msvc
compiler.cppstd=17
compiler.runtime=dynamic
# Release, to match build_type. The upstream owncloud/conan-center-index
# windows profile has runtime_type=Debug here, which is the same mistake.
compiler.runtime_type=Release
compiler.version=194
os=Windows

[conf]
tools.system.package_manager:mode=check

# qt, and on Linux glib and libselinux, pin pcre2/10.42, which has known CVEs
# fixed in 10.48. A replacement here, not an override in conanfile.py, so that
# it also reaches the build context, and for any pinned version. Drop it only
# once all of them require pcre2 with a lower bound of 10.48 or later
# (conan-io/conan-center-index#31497 proposes 10.43, which is not enough).
[replace_requires]
pcre2/*: pcre2/[>=10.48 <11]
