[settings]
arch=x86_64
build_type=Release
compiler=gcc
compiler.cppstd=gnu17
compiler.libcxx=libstdc++11
compiler.version=13
os=Linux

[conf]
tools.system.package_manager:mode=check

# The qt and glib recipes pin pcre2/10.42, which has known CVEs fixed in 10.48.
# A replacement here, not an override in conanfile.py, so that it also reaches
# the build context (on Linux, libsecret's tool glib). Drop it once the recipes
# take a range (conan-io/conan-center-index#31497).
[replace_requires]
pcre2/10.42: pcre2/[>=10.48 <11]
