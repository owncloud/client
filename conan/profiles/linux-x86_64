[settings]
arch=x86_64
build_type=Release
compiler=gcc
compiler.cppstd=gnu17
compiler.libcxx=libstdc++11
compiler.version=13
os=Linux

[conf]
# Qt links the shared OpenSSL (the qt recipe would load it by name at runtime),
# as KDE Craft's FEATURE_openssl_linked did: the version is pinned, and
# macdeployqt and linuxdeploy bundle a link dependency (windeployqt does not).
# The second line puts that conf into Qt's package ID.
qt/*:tools.cmake.cmaketoolchain:extra_variables={"INPUT_openssl": {"value": "linked", "cache": True, "type": "STRING", "force": True}, "QT_FEATURE_openssl_runtime": {"value": "OFF", "cache": True, "type": "BOOL", "force": True}}
qt/*:tools.info.package_id:confs=["tools.cmake.cmaketoolchain:extra_variables"]
tools.system.package_manager:mode=check
