[settings]
arch=x86_64
build_type=Release
compiler=apple-clang
compiler.cppstd=17
compiler.libcxx=libc++
compiler.version=21
os=Macos
os.version=13.0

[conf]
# Qt without dup3: built with the Xcode 27.2 SDK, which declares dup3 (macOS
# 27), Qt's qt_safe_dup2 called it unguarded (QProcess crashed on every start
# below macOS 27). dup2 + fcntl, as with older SDKs; the second line puts this into
# Qt's package ID.
qt/*:tools.cmake.cmaketoolchain:extra_variables={"FEATURE_dup3": {"value": "OFF", "cache": True, "type": "BOOL", "force": True}}
qt/*:tools.info.package_id:confs=["tools.cmake.cmaketoolchain:extra_variables"]
tools.system.package_manager:mode=check
# Built on an arm64 Mac as a cross build (-pr:b macos-armv8), except Qt: the
# qt recipe's cross build takes only the core host tools from a native Qt and
# fails in qtdeclarative. So Qt is built natively there, with
# CMAKE_OSX_ARCHITECTURES=x86_64, and runs its own x86_64 tools under Rosetta.
qt/*:tools.build.cross_building:cross_build=False
qt/*:tools.cmake.cmaketoolchain:system_name=

# qt, and on Linux glib and libselinux, pin pcre2/10.42, which has known CVEs
# fixed in 10.48. A replacement here, not an override in conanfile.py, so that
# it also reaches the build context, and for any pinned version. Drop it only
# once all of them require pcre2 with a lower bound of 10.48 or later
# (conan-io/conan-center-index#31497 proposes 10.43, which is not enough).
[replace_requires]
pcre2/*: pcre2/[>=10.48 <11]
