.tag                    export-subst
.gitignore              export-ignore
.gitattributes          export-ignore
.commit-template        export-ignore
binary/                 export-ignore

# Conan inputs: the shared CI rejects CR in them, so keep LF even on
# Windows runners that check out with core.autocrlf=true.
conan/profiles/**       text eol=lf
conan/recipes-commit    text eol=lf
conanfile.py            text eol=lf
conan.lock              text eol=lf

# Shell scripts (e.g. conan/update-lock.sh, run from Git Bash on Windows):
# bash fails on CRLF, so keep LF even with core.autocrlf=true.
*.sh                    text eol=lf
